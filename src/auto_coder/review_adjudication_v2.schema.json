{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kitamura-tetsuo/auto-coder/blob/main/src/auto_coder/review_adjudication_v2.schema.json",
  "title": "Auto-Coder scoped review correction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "context_id",
    "head_sha",
    "contract_digest",
    "verdict",
    "directive",
    "supersedes",
    "rationale",
    "source",
    "scoped_followup"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]+$"
    },
    "context_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]+$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "const": "UPHOLD"
    },
    "directive": {
      "const": "FIX"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "chatgpt-assisted",
        "dashboard"
      ]
    },
    "scoped_followup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "owner_incarnation",
        "payload",
        "distinct_from",
        "distinction"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^task_e_[A-Za-z0-9]+$"
        },
        "owner_incarnation": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "string",
          "minLength": 1
        },
        "distinction": {
          "type": "string",
          "minLength": 1
        },
        "distinct_from": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "UPHOLD"
          }
        }
      },
      "then": {
        "properties": {
          "directive": {
            "const": "FIX"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "OVERRULE"
          }
        }
      },
      "then": {
        "properties": {
          "directive": {
            "const": "NO_CHANGE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "UNDECIDED"
          }
        }
      },
      "then": {
        "properties": {
          "directive": {
            "const": "NONE"
          }
        }
      }
    }
  ]
}
